# Supabase (server-only — used for checkout session DB)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Circle App Kit (optional on testnet, required on production)
# Get yours at: https://console.circle.com
NEXT_PUBLIC_CIRCLE_KIT_KEY=

# WalletConnect Project ID — required by RainbowKit
# Get yours at: https://dashboard.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# App public configuration
NEXT_PUBLIC_APP_NAME=ArcFlow Pay
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Arc Testnet RPC (public endpoint)
NEXT_PUBLIC_ARC_TESTNET_RPC=https://rpc.testnet.arclabs.io

# Development only. Comma-separated host list for local network/mobile/ngrok testing.
# Example: 192.168.1.10:3000,example.ngrok-free.dev,localhost:3000
# Do not set this in Vercel Production.
ALLOWED_DEV_ORIGINS=
